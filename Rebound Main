-- TÁCH RIÊNG: PHÁT ÂM THANH NGAY LẬP TỨC KHI EXECUTE (ĐÉO ĐỜI SPAWNER)
-- =====================================================================
task.spawn(function()
    -- 🔊 1. Phát sound respawn ngay tức thì vào workspace
    local SoundRespawn = Instance.new("Sound")
    SoundRespawn.Name = "RespawnSound"
    SoundRespawn.SoundId = SoundRespawnId
    SoundRespawn.Volume = 1.35
    SoundRespawn.Parent = workspace
    SoundRespawn:Play()
    game:GetService("Debris"):AddItem(SoundRespawn, 10)

    -- 🔊 2. Lắng nghe workspace để gắn Sound 3D ngay khi Model "Smiler" vừa xuất hiện
    local entityModel = workspace:WaitForChild("ReboundChild", 10)
    if entityModel then
        local entityRoot = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart") or entityModel:WaitForChild("HumanoidRootPart", 5)
        
        if entityRoot then
            local SoundFar1 = Instance.new("Sound")
            SoundFar1.Name = "FarSound1"
            SoundFar1.SoundId = SoundFar1Id
            SoundFar1.Volume = 0.5
            SoundFar1.RollOffMaxDistance = 150
            SoundFar1.RollOffMinDistance = 10
            SoundFar1.RollOffMode = Enum.RollOffMode.Linear
            SoundFar1.Looped = true
            SoundFar1.Parent = entityRoot
            SoundFar1:Play()
            
            local SoundFar2 = Instance.new("Sound")
            SoundFar2.Name = "FarSound2"
            SoundFar2.SoundId = SoundFar2Id
            SoundFar2.Volume = 4
            SoundFar2.RollOffMaxDistance = 200
            SoundFar2.RollOffMinDistance = 10
            SoundFar2.RollOffMode = Enum.RollOffMode.Linear
            SoundFar2.Looped = true
            SoundFar2.Parent = entityRoot
            SoundFar2:Play()
            
            local SoundNear = Instance.new("Sound")
            SoundNear.Name = "NearSound"
            SoundNear.SoundId = SoundNearId
            SoundNear.Volume = 4
            SoundNear.RollOffMaxDistance = 55
            SoundNear.RollOffMinDistance = 5
            SoundNear.RollOffMode = Enum.RollOffMode.Linear
            SoundNear.Looped = true
            SoundNear.Parent = entityRoot
            SoundNear:Play()
        end
    end
end)

